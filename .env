# ===================================================
# CẤU HÌNH KẾT NỐI DATABASE POSTGRESQL NỘI BỘ
# ===================================================
# Điền IP host nội bộ (ví dụ: 192.168.1.100 hoặc 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ocean_tracker
DB_SSL=false

# Cổng chạy ứng dụng (Đặt 80 theo cấu hình Docker/máy chủ)
PORT=80
