# ===================================================
# CẤU HÌNH KẾT NỐI DATABASE POSTGRESQL NỘI BỘ
# ===================================================
# Địa chỉ IP hoặc hostname của máy chủ PostgreSQL nội bộ
DB_HOST=127.0.0.1

# Cổng kết nối PostgreSQL (mặc định: 5432)
DB_PORT=5432

# Tên người dùng database
DB_USER=postgres

# Mật khẩu database
DB_PASSWORD=your_password_here

# Tên database
DB_NAME=ocean_tracker

# Cấu hình SSL (true hoặc false)
DB_SSL=false

# Cổng phục vụ ứng dụng (Đặt 80 theo cấu hình máy chủ/Docker)
PORT=80
